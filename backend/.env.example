# Copier en .env et adapter. Ce fichier est le seul des deux qui est versionne :
# il documente les variables attendues sans jamais contenir de vraie valeur.

# Port d'ecoute de l'API.
PORT=3000

# Connexion PostgreSQL. En local, docker-compose fournit deja cette valeur.
DATABASE_URL=postgres://devops:devops@localhost:5432/tasksdb

# Force le TLS vers PostgreSQL meme si l'URL ne le reclame pas.
# Inutile en local, necessaire sur certaines bases managees.
DATABASE_SSL=false

# Cle de signature des jetons JWT. OBLIGATOIRE : le backend refuse de demarrer
# sans elle plutot que de signer avec une valeur par defaut connue de tous.
# Generer une valeur unique par environnement :
#   openssl rand -base64 48
JWT_SECRET=remplacer-par-une-valeur-aleatoire-unique
